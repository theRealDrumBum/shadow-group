NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CARD_SYNC_API_KEY=
# Used by Command card ingest: read a finished card image into the form, and
# draft a new card with the Cardsmith prompt. Leave blank to disable those actions.
OPENAI_API_KEY=
# Optional public site origin used in Cardsmith preview/gallery URLs.
# Falls back to the incoming request host when unset.
NEXT_PUBLIC_SITE_URL=

# Command login uses Supabase Auth. Email + password works for emails in
# public.allowed_accounts without configuring Google OAuth. Google remains
# optional if the Google provider is enabled in the Supabase project.
